RewriteEngine On

# Redirigir coming_soon.html a la pàgina principal
RewriteRule ^coming_soon\.html$ / [R=302,L]

# 1. Si és una carpeta real (com /img/ o /es/), entra-hi directament
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 2. TREURE EXTENSIÓ .HTML
# Si l'usuari demana /algo i existeix /algo.html, carrega el fitxer html
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# 3. GESTIÓ D'ERRORS (Opcional però recomanable)
ErrorDocument 404 /404.html
